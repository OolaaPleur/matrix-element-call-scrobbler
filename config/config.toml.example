# Optional: scripts/setup.py asks for everything the bot needs and keeps it in
# data/credentials.json. Copy this file to config/config.toml only to change the
# settings below; a value set here overrides the one from setup.

[matrix]
# Set by setup.py; override only if needed:
# homeserver  = "https://matrix.org"
# user_id     = "@scrobbler-bot:matrix.org"
device_name = "scrobbler"

[matrix.verification]
# Users whose verification requests the bot accepts (setup.py: your user ID).
# auto_accept_users = ["@yourusername:matrix.org"]

# [lastfm] api_key / shared_secret and [storage] encryption_key are set by setup.py.

[storage]
db_path        = "data/scrobbler.db"

[behavior]
# Users who may invite the bot into rooms (setup.py: your user ID).
# auto_accept_room_invites_from  = ["@yourusername:matrix.org"]
recovery_lookback_hours        = 6
abandoned_play_grace_seconds   = 60
queue_drain_interval_seconds   = 30
abandoned_sweep_interval_secs  = 300

[sources]
# Whitelist of source values to scrobble. ["*"] = allow all.
# Valid source values: "youtube_music", "youtube", "spotify", "other"
allowed = ["*"]
# Blacklist applied after allowed. Example: denied = ["other"]
denied  = []

[emitters]
# Matrix users whose track events are accepted (checked against the event's sender).
# ["*"] = anyone in the room — they could then scrobble anything to linked accounts.
# setup.py: the music bot's user ID.
# allowed_user_ids = ["@musicbot:matrix.org"]

[quality]
# If true, only scrobble events with metadata_quality == "high".
# "high" means yt-dlp provided artist/track fields directly (YT Music, Topic channels).
# "low" means metadata was derived from the title heuristic.
require_high = false
